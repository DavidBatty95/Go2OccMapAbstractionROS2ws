Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 15; 25; 40
    Fixed Frame: map
  Displays:
    - Class: rviz_default_plugins/Map
      Name: Observed occupancy
      Enabled: true
      Topic:
        Value: /map
        Durability Policy: Transient Local
    - Class: rviz_default_plugins/MarkerArray
      Name: Abstraction graph
      Enabled: true
      Topic:
        Value: /abstraction/graph
    - Class: rviz_default_plugins/Path
      Name: Planned route
      Enabled: true
      Topic:
        Value: /plan
    - Class: rviz_default_plugins/LaserScan
      Name: Ideal scan
      Enabled: true
      Topic:
        Value: /scan
    - Class: rviz_default_plugins/TF
      Name: Frames
      Enabled: true
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Scale: 60
      Angle: 0
      X: 0
      Y: 0
Window Geometry:
  Width: 1100
  Height: 850
